{
  "name": "screenify",
  "productName": "Screenify",
  "version": "1.12.0",
  "description": "Screenify — Open-Source macOS Screen Recording & Studio Video Editor with Spring-Physics Cursor Zoom, Local Whisper Captions, AI & Offline Smart Edit, and Teleprompter",
  "main": "main/index.js",
  "license": "MIT",
  "private": false,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "set -e; for f in main/*.js scripts/*.js; do node --check \"$f\"; done",
    "pack-app": "node scripts/install-macos-app.js",
    "install-app": "node scripts/install-macos-app.js --install",
    "sign-app": "node scripts/install-macos-app.js --install --sign \"Apple Development\"",
    "xcode": "open Screenify.xcodeproj",
    "xcode:build": "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodebuild -project Screenify.xcodeproj -scheme Screenify -configuration Debug build",
    "xcode:test": "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodebuild -project Screenify.xcodeproj -scheme Screenify -configuration Debug test",
    "build:dmg": "bash scripts/build-dmg.sh"
  },
  "mac": {
    "icon": "icons/logo.png"
  },
  "dependencies": {
    "@sentry/electron": "^7.1.1",
    "@xenova/transformers": "^2.17.2",
    "bindings": "^1.5.0",
    "check-disk-space": "^3.4.0",
    "electron-store": "^5.2.0",
    "electron-updater": "^6.6.2",
    "lru-cache": "^11.2.2",
    "media-devices-util": "^0.2.0",
    "mp4box": "^2.3.0",
    "node-mac-permissions": "^2.5.0",
    "node-machine-id": "^1.1.12",
    "posthog-node": "^4.5.0",
    "pump": "^3.0.3",
    "tar-fs": "^3.1.0"
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false,
    "http": false,
    "https": false,
    "net": false,
    "tls": false,
    "crypto": false,
    "stream": false,
    "zlib": false,
    "util": false,
    "assert": false,
    "url": false
  }
}
