# Screenify — Environment Configuration Example
# Copy this file to .env and configure optional integrations as needed.

# Optional: OpenAI API key for cloud AI Smart Edit & Whisper transcription
# When omitted, Screenify uses its built-in Offline Smart Edit Planner and local Whisper ONNX model.
OPENAI_API_KEY=

# Optional: Path to Screenify.app bundle for scripts/install-macos-app.js
SCREENIFY_APP_BUNDLE=

# Optional: Self-hosted API & update feed endpoints
SCREENIFY_API_BASE_URL=
SCREENIFY_UPDATE_FEED_URL=
SCREENIFY_ENABLE_AUTO_UPDATER=0
SCREENIFY_VIDEO_STATS_URL=

# Optional: License & quota verification configuration
SCREENIFY_LICENSE_API_BASE=
SCREENIFY_LICENSE_PUBLIC_KEY_B64=
SCREENIFY_APP_SECRET=
SCREENIFY_CIPHER_KEY=
SCREENIFY_PROMO_CODE=
SCREENIFY_QUOTA_SALT=

# Optional: Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Telemetry / Crash reporting (disabled by default)
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
